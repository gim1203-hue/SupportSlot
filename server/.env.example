PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/supportslot
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
# Optional: use your provider's OpenAI-compatible chat completions endpoint.
# Without these, the app explicitly uses a non-AI keyword fallback.
AI_CHAT_URL=
AI_API_KEY=
AI_MODEL=
# Used only by npm run seed. Set both to create an admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
